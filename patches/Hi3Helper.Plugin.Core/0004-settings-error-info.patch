+    // Native AOT's HRESULT conversion does not reliably publish IErrorInfo.
+    // Populate the standard COM error channel explicitly so the host retains
+    // the plugin's localized validation message without changing the ABI.
+    internal static unsafe HResult SettingsError(Exception exception)
+    {
+        int result = Marshal.GetHRForException(exception);
+        if (!OperatingSystem.IsWindows() || CreateErrorInfo(out nint creator) != 0 || creator == 0)
+            return result;
+
+        nint error = 0;
+        try
+        {
+            var table = *(nint**)creator;
+            fixed (char* description = exception.Message)
+            {
+                if (((delegate* unmanaged[Stdcall]<nint, char*, int>)table[5])(creator, description) != 0)
+                    return result;
+            }
+            Guid errorInfoId = new("1CF2B120-547D-101B-8E65-08002B2BD119");
+            if (((delegate* unmanaged[Stdcall]<nint, Guid*, nint*, int>)table[0])(creator, &errorInfoId, &error) == 0)
+                SetErrorInfo(0, error);
+        }
+        finally
+        {
+            if (error != 0) ((delegate* unmanaged[Stdcall]<nint, uint>)(*(nint**)error)[2])(error);
+            ((delegate* unmanaged[Stdcall]<nint, uint>)(*(nint**)creator)[2])(creator);
+        }
+        return result;
+    }
+
+    [LibraryImport("oleaut32.dll")]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static partial int CreateErrorInfo(out nint errorInfo);
+
+    [LibraryImport("oleaut32.dll")]
+    [DefaultDllImportSearchPaths(DllImportSearchPath.System32)]
+    private static partial int SetErrorInfo(uint reserved, nint errorInfo);
 }

